---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import { contactLinks, education, roles, site } from '../config/site';
---

<Layout
  title={site.title}
  description={site.description}
>
  <PageHeader title={site.name} links={contactLinks} />

  <div class="mt-12 grid gap-12">
    <div class="grid gap-7">
      {
        roles.map((role) => (
          <article class="grid grid-cols-[minmax(0,1fr)_auto] items-baseline gap-gutter max-md:grid-cols-1 max-md:gap-[0.4rem]">
            <div>
              <h2 class="mb-[4px] font-body text-[21px] leading-[1.4] font-semibold tracking-normal text-text max-md:text-[20px]">
                {role.company}
              </h2>
              <time class="hidden font-body text-[16px] leading-[1.6] font-normal text-text-soft max-md:block">
                {role.period}
              </time>
              <p class="font-prose text-[18px] leading-[1.7] text-text-muted">{role.title}</p>
            </div>
            <time class="whitespace-nowrap font-body text-[16px] leading-[1.6] font-normal text-text-soft max-md:hidden">
              {role.period}
            </time>
          </article>
        ))
      }
    </div>

    <article class="grid grid-cols-[minmax(0,1fr)_auto] items-baseline gap-gutter max-md:grid-cols-1 max-md:gap-[0.4rem]">
      <div>
        <h2 class="mb-[4px] font-body text-[21px] leading-[1.4] font-semibold tracking-normal text-text max-md:text-[20px]">
          {education.school}
        </h2>
        <time datetime={education.graduationYear} class="hidden font-body text-[16px] leading-[1.6] font-normal text-text-soft max-md:block">
          {education.period}
        </time>
        <p class="font-prose text-[18px] leading-[1.7] text-text-muted">{education.degree}</p>
      </div>
      <time datetime={education.graduationYear} class="whitespace-nowrap font-body text-[16px] leading-[1.6] font-normal text-text-soft max-md:hidden">
        {education.period}
      </time>
    </article>
  </div>
</Layout>
